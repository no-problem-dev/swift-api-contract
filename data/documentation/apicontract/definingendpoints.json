{"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"type":"text","text":"このガイドでは、APIContractの各マクロの詳細な使い方と、様々なパターンのエンドポイント定義を説明します。"}],"type":"paragraph"},{"anchor":"Endpoint%E3%83%9E%E3%82%AF%E3%83%AD","level":2,"text":"@Endpointマクロ","type":"heading"},{"inlineContent":[{"type":"codeVoice","code":"@Endpoint"},{"text":"マクロは、構造体をAPIエンドポイントに変換します。","type":"text"}],"type":"paragraph"},{"anchor":"%E5%9F%BA%E6%9C%AC%E6%A7%8B%E6%96%87","level":3,"text":"基本構文","type":"heading"},{"syntax":"swift","code":["@Endpoint(.httpMethod, path: \"optional\/sub\/path\")","struct EndpointName {","    \/\/ パラメータ定義","    typealias Output = ResponseType","}"],"type":"codeListing"},{"anchor":"HTTP%E3%83%A1%E3%82%BD%E3%83%83%E3%83%89","level":3,"text":"HTTPメソッド","type":"heading"},{"inlineContent":[{"type":"text","text":"サポートされるHTTPメソッド："}],"type":"paragraph"},{"rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"メソッド"}]}],[{"inlineContent":[{"type":"text","text":"用途"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".get","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"リソースの取得"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":".post"}],"type":"paragraph"}],[{"inlineContent":[{"text":"リソースの作成","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":".put"}],"type":"paragraph"}],[{"inlineContent":[{"text":"リソースの完全更新","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":".patch"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"リソースの部分更新"}],"type":"paragraph"}]],[[{"type":"paragraph","inlineContent":[{"code":".delete","type":"codeVoice"}]}],[{"inlineContent":[{"text":"リソースの削除","type":"text"}],"type":"paragraph"}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".head"}]}],[{"type":"paragraph","inlineContent":[{"text":"ヘッダーのみ取得","type":"t