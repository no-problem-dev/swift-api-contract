:[{"type":"text","text":"リクエストボディを定義します。"},{"type":"codeVoice","code":"Encodable"},{"type":"text","text":"に準拠した型を使用します。"}],"type":"paragraph"},{"syntax":"swift","code":["struct CreateUserRequest: Codable {","    let name: String","    let email: String","}","","@Endpoint(.post)","struct CreateUser {","    @Body var body: CreateUserRequest","","    typealias Output = User","}","","\/\/ リクエストボディがJSON形式でエンコードされる","let endpoint = CreateUser(body: CreateUserRequest(name: \"John\", email: \"john@example.com\"))"],"type":"codeListing"},{"anchor":"%E5%9E%8B%E3%82%B5%E3%83%9D%E3%83%BC%E3%83%88","level":2,"text":"型サポート","type":"heading"},{"anchor":"%E3%83%91%E3%83%A9%E3%83%A1%E3%83%BC%E3%82%BF%E3%81%A7%E4%BD%BF%E7%94%A8%E5%8F%AF%E8%83%BD%E3%81%AA%E5%9E%8B","level":3,"text":"パラメータで使用可能な型","type":"heading"},{"inlineContent":[{"text":"以下の型がパスパラメータとクエリパラメータで使用できます：","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"文字列","type":"text"}]},{"type":"text","text":": "},{"type":"codeVoice","code":"String"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"整数","type":"text"}]},{"type":"text","text":": "},{"code":"Int","type":"codeVoice"},{"type":"text","text":", "},{"code":"Int8","type":"codeVoice"},{"type":"text","text":", "},{"code":"Int16","type":"codeVoice"},{"type":"text","text":", "},{"code":"Int32","type":"codeVoice"},{"type":"text","text":", "},{"code":"Int64","type":"codeVoice"},{"type":"text","text":", "},{"code":"UInt","type":"codeVoice"},{"type":"text","text":", "},{"code":"UInt8","type":"codeVoice"},{"type":"text","text":", "},{"code":"UInt16","type":"codeVoice"},{"type":"text","text":", "},{"code":"UInt32","type":"codeVoice"},{"type":"text","text":", "},{"code":"UInt64","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"浮動小数点"}]},{"type":"text","text":": "},{"type":"codeVoice","code":"Double"},{"type":"text","text":", "},{"type":"codeVoice","code":"Float"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"真偽値","type":"text"}]},{"type":"text","text":": "},{"type":"codeVoice","code":"Bool"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"日付","type":"text"}]},{"text":": ","type":"text"},{"type":"codeVoice","code":"Date"},{"text":"（ISO8601形式で自動変換）","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Enum"}],"type":"strong"},{"text":": ","type":"text"},{"type":"codeVoice","code":"RawRepresentable"},{"text":"な型","type":"text"}]}]}]},{"syntax":"swift","code":["enum Status: String {","    case active, inactive","}","","@Endpoint(.get)","struct FilterUsers {","    @QueryParam var status: Status","    @QueryParam var createdAfter: Date?","","    typealias Output = [User]","}"],"type":"codeListing"},{"anchor":"%E7%89%B9%E6%AE%8A%E3%81%AA%E5%9E%8B","level":3,"text":"特殊な型","type":"heading"},{"anchor":"EmptyInput","level":4,"text":"EmptyInput","type":"heading"},{"inlineContent":[{"type":"text","text":"パラメータなしのエンドポイントに使用します。"}],"type":"paragraph"},{"syntax":"swift","code":["@Endpoint(.get)","struct GetServerStatus {","    typealias Output = ServerStatus","}"],"type":"codeListing"},{"anchor":"EmptyOutput","level":4,"text":"EmptyOutput","type":"heading"},{"inlineContent":[{"text":"レスポンスボディがないエンドポイント（DELETEなど）に使用します。","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["@Endpoint(.delete, path: \":id\")","struct DeleteUser {","    @PathParam var id: String","    typealias Output = EmptyOutput","}"],"type":"codeListing"},{"anchor":"APIGroup%E3%83%9E%E3%82%AF%E3%83%AD","level":2,"text":"@APIGroupマクロ","type":"heading"},{"inlineContent":[{"text":"関連するエンドポイントをグループ化し、共通のベースパスと認証設定を定義します。","type":"text"}],"type":"paragraph"},{"anchor":"%E5%9F%BA%E6%9C%AC%E6%A7%8B%E6%96%87","level":3,"text":"基本構文","type":"heading"},{"syntax":"swift","code":["@APIGroup(path: \"\/v1\/resource\", auth: .required)","enum ResourceAPI {","    \/\/ エンドポイント定義","}"],"type":"codeListing"},{"anchor":"%E8%AA%8D%E8%A8%BC%E8%A6%81%E4%BB%B6","level":3,"text":"認証要件","type":"heading"},{"rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"値"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"説明"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".none"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"認証不要"}]}]],[[{"type":"paragraph","inlineContent":[{"code":".required","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"認証必要"}]}]]],"type":"table","header":"row"},{"anchor":"%E3%82%B0%E3%83%AB%E3%83%BC%E3%83%97%E5%8C%96%E3%81%AE%E4%BE%8B","level":3,"text":"グループ化の例","type":"heading"},{"syntax":"swift","code":["\/\/ ユーザーAPI","@APIGroup(path: \"\/v1\/users\", auth: .required)","enum UsersAPI {","    @Endpoint(.get) struct List { ... }","    @Endpoint(.get, path: \":id\") struct Get { ... }","    @Endpoint(.post) struct Create { ... }","    @Endpoint(.put, path: \":id\") struct Update { ... }","    @Endpoint(.delete, path: \":id\") struct Delete { ... }","}","","\/\/ 認証API（認証不要）","@APIGroup(path: \"\/v1\/auth\", auth: .none)","enum AuthAPI {","    @Endpoint(.post, path: \"login\") struct Login { ... }","    @Endpoint(.post, path: \"register\") struct Register { ... }","    @Endpoint(.post, path: \"refresh\") struct Refresh { ... }","}"],"type":"codeListing"},{"anchor":"%E5%AE%8C%E5%85%A8%E3%81%AA%E4%BE%8B","level":2,"text":"完全な例","type":"heading"},{"syntax":"swift","code":["import APIContract","","\/\/ モデル定義","struct User: Codable {","    let id: String","    let name: String","    let email: String","}","","struct CreateUserRequest: Codable {","    let name: String","    let email: String","}","","struct UpdateUserRequest: Codable {","    let name: String?","    let email: String?","}","","\/\/ API定義","@APIGroup(path: \"\/v1\/users\", auth: .required)","enum UsersAPI {","    @Endpoint(.get)","    struct List {","        @QueryParam var limit: Int?","        @QueryParam var offset: Int?","        @QueryParam var status: String?","","        typealias Output = [User]","    }","","    @Endpoint(.get, path: \":userId\")","    struct Get {","        @PathParam var userId: String","","        typealias Output = User","    }","","    @Endpoint(.post)","    struct Create {","        @Body var body: CreateUserRequest","","        typealias Output = User","    }","","    @Endpoint(.patch, path: \":userId\")","    struct Update {","        @PathParam var userId: String","        @Body var body: UpdateUserRequest","","        typealias Output = User","    }","","    @Endpoint(.delete, path: \":userId\")","    struct Delete {","        @PathParam var userId: String","","        typealias Output = EmptyOutput","    }","}"],"type":"codeListing"}]}],"kind":"article","metadata":{"modules":[{"name":"APIContract"}],"role":"article","color":{"standardColorIdentifier":"blue"},"title":"エンドポイントの定義","roleHeading":"Article"},"sections":[],"hierarchy":{"paths":[["doc:\/\/APIContract\/documentation\/APIContract"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/apicontract\/definingendpoints"]}],"seeAlsoSections":[{"title":"はじめに","identifiers":["doc:\/\/APIContract\/documentation\/APIContract\/GettingStarted"],"generated":true,"anchor":"はじめに"}],"schemaVersion":{"minor":3,"major":0,"patch":0},"abstract":[{"text":"APIContractでエンドポイントを定義する詳細なガイド。","type":"text"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/APIContract\/documentation\/APIContract\/DefiningEndpoints"},"references":{"doc://APIContract/documentation/APIContract":{"url":"\/documentation\/apicontract","type":"topic","abstract":[{"type":"text","text":"Swiftマクロを活用した型安全なAPIコントラクト定義ライブラリ。"}],"kind":"symbol","role":"collection","identifier":"doc:\/\/APIContrac