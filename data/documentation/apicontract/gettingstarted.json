{"schemaVersion":{"minor":3,"patch":0,"major":0},"abstract":[{"type":"text","text":"APIContractを使用してAPIエンドポイントを定義する方法を学びます。"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/APIContract\/documentation\/APIContract\/GettingStarted"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/apicontract\/gettingstarted"]}],"sections":[],"primaryContentSections":[{"content":[{"type":"heading","level":2,"text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"このガイドでは、APIContractを使用してAPIエンドポイントを定義し、実行する基本的な方法を説明します。"}]},{"type":"heading","level":2,"text":"インストール","anchor":"%E3%82%A4%E3%83%B3%E3%82%B9%E3%83%88%E3%83%BC%E3%83%AB"},{"type":"paragraph","inlineContent":[{"text":"Swift Package Managerを使用してインストールします。","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["dependencies: [","    .package(url: \"https:\/\/github.com\/no-problem-dev\/swift-api-contract.git\", from: \"1.0.0\")","]"]},{"type":"paragraph","inlineContent":[{"text":"ターゲットに追加：","type":"text"}]},{"syntax":"swift","type":"codeListing","code":[".target(","    name: \"YourTarget\",","    dependencies: [","        .product(name: \"APIContract\", package: \"swift-api-contract\")","    ]",")"]},{"type":"heading","level":2,"text":"基本的なエンドポイント定義","anchor":"%E5%9F%BA%E6%9C%AC%E7%9A%84%E3%81%AA%E3%82%A8%E3%83%B3%E3%83%89%E3%83%9D%E3%82%A4%E3%83%B3%E3%83%88%E5%AE%9A%E7%BE%A9"},{"type":"heading","level":3,"text":"シンプルなGETエンドポイント","anchor":"%E3%82%B7%E3%83%B3%E3%83%97%E3%83%AB%E3%81%AAGET%E3%82%A8%E3%83%B3%E3%83%89%E3%83%9D%E3%82%A4%E3%83%B3%E3%83%88"},{"type":"paragraph","inlineContent":[{"text":"最もシンプルなエンドポイントは、パラメータなしのGETリクエストです。","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["import APIContract","","@Endpoint(.get)","struct ListUsers {","    typealias Output = [User]","}"]},{"text":"パスパラメータを持つエンドポイント","type":"heading","anchor":"%E3%83%91%E3%82%B9%E3%83%91%E3%83%A9%E3%83%A1%E3%83%BC%E3%82%BF%E3%82%92%E6%8C%81%E3%81%A4%E3%82%A8%E3%83%B3%E3%83%89%E3%83%9D%E3%82%A4%E3%83%B3%E3%83%88","level":3},{"type":"paragraph","inlineContent":[{"text":"パスパラメータは","type":"text"},{"type":"codeVoice","code":"@PathParam"},{"text":"でマークします。","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["@Endpoint(.get, path: \":userId\")","struct GetUser {","    @PathParam var userId: String","    typealias Output = User","}"]},{"text":"クエリパラメータを持つエンドポイント","type":"heading","anchor":"%E3%82%AF%E3%82%A8%E3%83%AA%E3%83%91%E3%83%A9%E3%83%A1%E3%83%BC%E3%82%BF%E3%82%92%E6%8C%81%E3%81%A4%E3%82%A8%E3%83%B3%E3%83%89%E3%83%9D%E3%82%A4%E3%83%B3%E3%83%88","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"クエリパラメータは"},{"code":"@QueryParam","type":"codeVoice"},{"type":"text","text":"でマークします。"}]},{"code":["@Endpoint(.get)","struct SearchUsers {","    @QueryParam var query: String","    @QueryParam var limit: Int?","    @QueryParam(\"page_size\") var pageSize: Int?  \/\/ カスタム名","","    typealias Output = [User]","}"],"type":"codeListing","syntax":"swift"},{"text":"リクエストボディを持つエンドポイント","type":"heading","anchor":"%E3%83%AA%E3%82%AF%E3%82%A8%E3%82%B9%E3%83%88%E3%83%9C%E3%83%87%E3%82%A3%E3%82%92%E6%8C%81%E3%81%A4%E3%82%A8%E3%83%B3%E3%83%89%E3%83%9D%E3%82%A4%E3%83%B3%E3%83%88","level":3},{"type":"paragraph","inlineContent":[{"text":"リクエストボディは","type":"text"},{"code":"@Body","type":"codeVoice"},{"text":"でマークします。","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["@Endpoint(.post)","struct CreateUser {","    @Body var body: CreateUserRequest","    typealias Output = User","}"]},{"anchor":"API%E3%82%B0%E3%83%AB%E3%83%BC%E3%83%97%E3%81%AE%E5%AE%9A%E7%BE%A9","type":"heading","level":2,"text":"APIグループの定義"},{"inlineContent":[{"type":"text","text":"関連するエンドポイントは"},{"code":"@APIGroup","type":"codeVoice"},{"type":"text","text":"でグループ化できます。"}],"type":"paragraph"},{"syntax":"swift","code":["@APIGroup(path: \"\/v1\/users\", auth: .required)","enum UsersAPI {","    @Endpoint(.get)","    struct List {","        @QueryParam var limit: Int?","        typealias Output = [User]","    }","","    @Endpoint(.get, path: \":userId\")","    struct Get {","        @PathParam var userId: String","        typealias Output = User","    }","","    @Endpoint(.post)","    struct Create {","        @Body var body: CreateUserRequest","        typealias Output = User","    }","","    @Endpoint(.delete, path: \":userId\")","    struct Delete {","        @PathParam var userId: String","        typealias Output = EmptyOutput","    }","}"],"type":"codeListing"},{"anchor":"%E3%82%A8%E3%83%B3%E3%83%89%E3%83%9D%E3%82%A4%E3%83%B3%E3%83%88%E3%81%AE%E5%AE%9F%E8%A1%8C","level":2,"text":"エンドポイントの実行","type":"heading"},{"anchor":"APIExecutor%E3%81%AE%E5%AE%9F%E8%A3%85","level":3,"text":"APIExecutorの実装","type":"heading"},{"inlineContent":[{"text":"まず、","type":"text"},{"code":"APIExecutor","type":"codeVoice"},{"text":"プロトコルを実装したクライアントを作成します。","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["struct MyAPIClient: APIExecutor {","    let baseURL: String","    let session: URLSession","","    func execute<E: APIContract>(_ endpoint: E) async throws -> E.Output","    where E.Output: Decodable {","        let request = try endpoint.urlRequest(baseURL: baseURL)","        let (data, _) = try await session.data(for: request)","        return try JSONDecoder().decode(E.Output.self, from: data)","    }","","    func execute<E: APIContract>(_ endpoint: E) async throws","    where E.Output == EmptyOutput {","        let request = try endpoint.urlRequest(baseURL: baseURL)","        _ = try await session.data(for: request)","    }","}"],"type":"codeListing"},{"anchor":"%E3%83%AA%E3%82%AF%E3%82%A8%E3%82%B9%E3%83%88%E3%81%AE%E5%AE%9F%E8%A1%8C","level":3,"text":"リクエストの実行","type":"heading"},{"syntax":"swift","code":["let client = MyAPIClient(","    baseURL: \"https:\/\/api.example.com\",","    session: .shared",")","","\/\/ ユーザー一覧を取得","let users = try await UsersAPI.List(limit: 10).execute(using: client)","","\/\/ 特定のユーザーを取得","let user = try await UsersAPI.Get(userId: \"123\").execute(using: client)","","\/\/ 新しいユーザーを作成","let newUser = try await UsersAPI.Create(","    body: CreateUserRequest(name: \"John\", email: \"john@example.com\")",").execute(using: client)"],"type":"codeListing"},{"anchor":"%E6%AC%A1%E3%81%AE%E3%82%B9%E3%83%86%E3%83%83%E3%83%97","level":2,"text":"次のステップ","type":"heading"},{"items":[{"content":[{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/APIContract\/documentation\/APIContract\/DefiningEndpoints"},{"type":"text","text":" - より詳細なエンドポイント定義の方法"}],"type":"paragraph"}]}],"type":"unorderedList"}],"kind":"content"}],"kind":"article","seeAlsoSections":[{"title":"はじめに","generated":true,"identifiers":["doc:\/\/APIContract\/documentation\/APIContract\/DefiningEndpoints"],"anchor":"はじめに"}],"metadata":{"modules":[{"name":"APIContract"}],"roleHeading":"Article","role":"article","title":"はじめに","color":{"standardColorIdentifier":"blue"}},"hierarchy":{"paths":[["doc:\/\/APIContract\/documentation\/APIContract"]]},"references":{"doc://APIContract/documentation/APIContract/DefiningEndpoints":{"role":"article","abstract":[{"text":"APIContractでエンドポイントを定義する詳細なガイド。","type":"text"}],"identifier":"doc:\/\/APIContract\/documentation\/APIContract\/DefiningEndpoints","url":"\/documentation\/apicontract\/definingendpoints","title":"エンドポイントの定義","type":"topic","kind":"article"},"doc://APIContract/documentation/APIContract":{"url":"\/documentation\/apicontract","identifier":"doc:\/\/APIContract\/documentation\/APIContract","type":"topic","kind":"symbol","role":"collection","title":"APIContract","abstract":[{"text":"Swiftマクロを活用した型安全なAPIコントラクト定義ライブラリ。","type":"text"}]}}}